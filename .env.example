# Copy to .env.local and fill in. .env.local is gitignored.

# MongoDB connection string. Local mongod, or an Atlas SRV URI:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=arizona

# Signs the admin session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Outgoing mail — used for the registration verification code.
# 465 = implicit SSL, 587 = STARTTLS (then set SMTP_SECURE=false).
# GoDaddy Microsoft 365: smtp.office365.com / 587 / false
# GoDaddy Workspace:     smtpout.secureserver.net / 465 / true
# Leave SMTP_HOST blank to auto-probe those hosts on first send.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@yourdomain.com
# NOTE: Next expands $ in env values — write a literal $ as \$ (pass\$123)
SMTP_PASS=your-mailbox-password
SMTP_FROM=Arizona Women Specialists <info@yourdomain.com>

# Admin sign-in is NOT configured here — accounts live in the `admins`
# collection with scrypt-hashed passwords. Create one with:
#   npm run seed
#   npm run seed -- --email you@clinic.com --password "your password"

# ---------------------------------------------------------------- Meta ads --
# Leave these blank and nothing tracking-related loads: no pixel script, no
# consent banner, no server events. The site behaves exactly as it did before.
#
# Both numbers come from Events Manager. The dataset ID and the "pixel ID" are
# the SAME number — it ships inside the browser bundle by definition, so it is
# public and must keep the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API token from Business Settings > Users > System users.
# THIS IS A SECRET. Never prefix it with NEXT_PUBLIC_, never commit it, never
# paste it into chat or email. Set it in the Vercel dashboard.
META_CAPI_ACCESS_TOKEN=

# Optional. Graph API versions stop working after roughly two years — bump this
# without a deploy when that happens. Defaults to v21.0 in src/lib/meta.ts.
# META_GRAPH_VERSION=v21.0

# Optional, TESTING ONLY. Set while verifying in Events Manager > Test Events.
# MUST be removed before launch or live events land in test mode and nothing
# counts for real.
# META_TEST_EVENT_CODE=

# Absolute site URL — used for canonical links and social previews.
NEXT_PUBLIC_SITE_URL=https://arizonawomenspecialists.com
