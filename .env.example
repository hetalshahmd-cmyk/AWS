# Copy to .env.local and fill in. .env.local is gitignored.

# MongoDB connection string. Local mongod, or an Atlas SRV URI:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=arizona

# Signs the admin session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Admin sign-in is NOT configured here — accounts live in the `admins`
# collection with scrypt-hashed passwords. Create one with:
#   npm run seed
#   npm run seed -- --email you@clinic.com --password "your password"
