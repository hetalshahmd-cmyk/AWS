# Copy to .env.local and fill in. .env.local is gitignored.

# MongoDB connection string. Local mongod, or an Atlas SRV URI:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=arizona

# Signs the admin session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Outgoing mail — used for the registration verification code.
# 465 = implicit SSL, 587 = STARTTLS (then set SMTP_SECURE=false).
# GoDaddy Microsoft 365: smtp.office365.com / 587 / false
# GoDaddy Workspace:     smtpout.secureserver.net / 465 / true
# Leave SMTP_HOST blank to auto-probe those hosts on first send.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@yourdomain.com
# NOTE: Next expands $ in env values — write a literal $ as \$ (pass\$123)
SMTP_PASS=your-mailbox-password
SMTP_FROM=Arizona Women Specialists <info@yourdomain.com>

# Admin sign-in is NOT configured here — accounts live in the `admins`
# collection with scrypt-hashed passwords. Create one with:
#   npm run seed
#   npm run seed -- --email you@clinic.com --password "your password"
